# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.rayanco.com
# Staging stays noindex. Only set to "true" on production after go-live sign-off.
NEXT_PUBLIC_INDEXABLE=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (images) ---
# TODO(owner): create the R2 bucket + API token, then fill these in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_URL=https://media.rayanco.com

# --- Contact ---
# TODO(owner): confirm the WhatsApp number for listings (international format, digits only, e.g. 966509747741).
NEXT_PUBLIC_WHATSAPP_NUMBER=
